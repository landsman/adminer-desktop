{
    "name": "landsman/adminer-desktop",
    "description": "Adminer as a desktop app.",
    "license": "Apache-2.0",
    "type": "project",
    "require-dev": {
        "behat/behat": "^4.0",
        "cweagans/composer-patches": "^2.0",
        "dg/composer-cleaner": "^2.2",
        "nette/tester": "^2.5",
        "playwright-php/playwright": "^1.2",
        "slevomat/coding-standard": "^8.16",
        "squizlabs/php_codesniffer": "^4.0",
        "vrana/adminer": "6.1.1"
    },
    "config": {
        "allow-plugins": {
            "dg/composer-cleaner": true,
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "cweagans/composer-patches": true
        },
        "sort-packages": true
    },
    "require": {
        "latte/latte": "^3.1",
        "tracy/tracy": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "Desktop\\": "src/"
        },
        "exclude-from-classmap": [
            "vendor/vrana/adminer/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Desktop\\Tests\\": "../tests/e2e/bootstrap/"
        }
    },
    "extra": {
        "cleaner-ignore": {
            "behat/behat": true,
            "behat/gherkin": true,
            "vrana/adminer": true
        }
    }
}
