{
    "name": "landsman/adminer-desktop",
    "description": "Adminer as a desktop app.",
    "license": "Apache-2.0",
    "type": "project",
    "require-dev": {
        "behat/behat": "^4.0",
        "dg/composer-cleaner": "^2.2",
        "dibi/dibi": "^5.1",
        "dresscode/dresscode": "^1.3.1",
        "nette/tester": "^2.5",
        "phpstan/phpstan": "2.3.4",
        "phpstan/phpstan-strict-rules": "2.1.0",
        "playwright-php/playwright": "^1.2"
    },
    "config": {
        "allow-plugins": {
            "dg/composer-cleaner": true
        },
        "sort-packages": true
    },
    "require": {
        "latte/latte": "^3.1",
        "tracy/tracy": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "Desktop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Desktop\\Cli\\": "cli/",
            "Desktop\\Tests\\": "../tests/e2e/bootstrap/"
        }
    },
    "extra": {
        "cleaner-ignore": {
            "behat/behat": true,
            "behat/gherkin": true
        }
    }
}
