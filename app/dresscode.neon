# The conventions phpstan does not judge, on the PHP we wrote. No coding standard: the code
# follows adminer's, and only what is decided here gets reported.
# https://dresscode.run/

# cli/ lies outside this root, where a directory is not walked: cli/dresscode.sh names its files.
paths:
	- .

# Beside vendor/ on purpose: from anywhere else DressCode takes app/, its own installation, for
# foreign code, and the rules that need types find nothing there and still exit 0.
typeAnalysis: phpstan

# Everything that ships verbatim from the adminer release keeps its own conventions.
excludePaths:
	- vendor
	- adminer.php
	- editor.php
	- src/Settings/Plugins/available
	- src/Settings/Theme/designs

# composer.json names no PHP version; this is frankenphp's, the one the app runs on.
targets:
	php: 8.5

# strict_types only applies to the file that declares it, so one missing is a silent hole.
file:
	finalLineEndings: 1
	trailingWhitespace: forbidden
	strictTypes:
		declaration: required
		position: nextLine

indentation:
	unit: tab

literals:
	arraySyntax:
		array: short

# A bare @var is not enough. phpstan cannot say this: its missing-type rule for constants only
# looks inside a type that is already written, so `const MAX = 2000` is invisible to it.
types:
	declaration:
		property: required
		constant: required

# PHP then refuses a parent renaming a member under us, instead of leaving a silent new one.
upgrading:
	classes:
		Override: required
