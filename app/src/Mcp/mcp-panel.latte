{* Letting an agent query the open database: the switch, and the command to register it.

	The command is generated rather than documented because only the app knows where it was
	installed — see Panel::command(). It sits in a readonly input rather than a <pre> so it can
	be selected and copied, and so a long bundle path scrolls instead of stretching the dialog;
	selecting it on click is src/Assets/javascript/mcp-panel.js, bound by id. Not an onclick
	attribute: the page's CSP carries strict-dynamic, which makes the 'unsafe-inline' beside it
	ignored, so an inline handler would work under -debug and nowhere else.
*}
{parameters
	\AdminerDesktop $desktop,
	bool $enabled,
	bool $write,
	string $os,
	array $commands,
	array $status,
	?string $lastUsed,
	?string $target
}
<p>
	<input type="checkbox" name="mcp" value="1" id="desktop-mcp" n:attr="checked: $enabled">
	<label for="desktop-mcp">{$desktop->t('mcp.enable')}</label>
</p>

<p class="ad-mcp-note">{$desktop->t('mcp.description')}</p>

{* Its own decision, and its own line: reading your database and rewriting it are not the same
	permission, so ticking the first must not quietly grant the second. *}
<p>
	<input type="checkbox" name="mcp_write" value="1" id="desktop-mcp-write" n:attr="checked: $write">
	<label for="desktop-mcp-write">{$desktop->t('mcp.write_enable')}</label>
</p>

<p n:class="'ad-mcp-note', $write ? 'ad-mcp-warn'">{$desktop->t($write ? 'mcp.write_on' : 'mcp.write_off')}</p>

<p class="ad-mcp-status">
	{* Both classes go through n:class — Latte rejects a plain class attribute beside it. *}
	<span n:class="'ad-mcp-dot', $status['ready'] ? 'ad-mcp-on'">&#9679;</span>
	{$status['text']}
</p>

{* Only once something has actually called: "never used" is the default and saying so on every
	open would be noise. Seeing a recent query you did not ask for is the point. *}
{* Which connection, because the agent follows the window: browsing to another database
	repoints it, and with several servers open in turn that is not obvious from anywhere else. *}
<p n:if="$target !== null" class="ad-mcp-note">
	{$desktop->t('mcp.target')} <span class="ad-mcp-target">{$target}</span>
</p>

<p n:if="$lastUsed !== null" class="ad-mcp-note">{$lastUsed}</p>

<fieldset>
	<legend>{$desktop->t('mcp.register_on')} {$os}</legend>
	{* One per agent: the command is the same but each CLI registers it under its own name, and
		guessing which one the reader uses is how the panel ended up looking Claude-specific. *}
	<div n:foreach="$commands as $agent => $command" class="ad-mcp-agent">
		<p class="ad-mcp-agent-name">{$agent}</p>
		{include '../Assets/copy-field.latte',
			value: $command,
			label: $agent,
			copy: $desktop->t('mcp.copy'),
			copied: $desktop->t('mcp.copied'),
			rows: 3}
	</div>
	<p class="ad-mcp-note">{$desktop->t('mcp.register_hint')}</p>
	<p class="ad-mcp-note">{$desktop->t('mcp.register_manual')}</p>
</fieldset>

<p class="ad-mcp-note">{$desktop->t('mcp.readonly_note')}</p>
