{* The dialogs the cards open (Connections::dialogs()), in the same order as the cards, so
	ad-connection-N is card N: its editor, and the questions before logging out of it and before
	forgetting it.

	Printed in the sidebar, outside adminer's login form: a form cannot nest, and Enter in the name
	field has to save the name rather than log in. Posted to AdminerDesktop::handlePost(). *}
{parameters
	\AdminerDesktop $desktop,
	array $connections,
	array $colors,
	array $environments
}
{foreach $connections as $connection}
	{var $n = $iterator->counter}
	{embed '../Assets/modal.latte', id: 'ad-connection-' . $n, class: 'ad-connection-dialog', guard: true, labelledBy: 'ad-connection-title-' . $n}
		{block hidden}
			{input_hidden('desktop_connection', $connection->key())|noescape}
			{input_token()|noescape}
		{/block}

		{block header}
			<h2 id="ad-connection-title-{$n}"><span class="ad-card-icon">{$connection->icon()|noescape}</span> {$connection->address()}</h2>
		{/block}

		{block body}
			<label class="ad-field">
				<span>{$desktop->t('connections.name')}</span>
				<input name="name" value="{$connection->name}" placeholder="{$connection->address()}" maxlength="60" autocomplete="off" autofocus>
			</label>

			{* Each environment carries its colour, so picking one picks that swatch too
				(connections.js); the swatch stays the user's to change. *}
			<label class="ad-field">
				<span>{$desktop->t('connections.environment')}</span>
				<select name="env">
					<option value="">{$desktop->t('connections.none')}</option>
					<option n:foreach="$environments as $environment" value="{$environment->value}" data-color="{$environment->color()->value}" n:attr="selected: $connection->environment === $environment">{$environment->label()}</option>
				</select>
			</label>

			<fieldset class="ad-swatches">
				<legend>{$desktop->t('connections.color')}</legend>
				<label title="{$desktop->t('connections.none')}"><input type="radio" name="color" value="" n:attr="checked: !$connection->suggestedColor()"><span class="ad-swatch ad-swatch-none"></span></label>
				<label n:foreach="$colors as $color" title="{$color->value}">
					<input type="radio" name="color" value="{$color->value}" n:attr="checked: $connection->suggestedColor() === $color">
					<span class="ad-swatch" style="background: {$color->hex()|noescape}"></span>
				</label>
			</fieldset>
		{/block}

		{block footer}
			<button type="button" data-close>{$desktop->t('settings.close')}</button>
			<button type="submit" class="ad-primary ad-save">{$desktop->t('settings.save')}</button>
		{/block}
	{/embed}

	{* Logging out keeps the card; it only drops the password. Not a danger: nothing is lost
		that cannot be typed again. *}
	{embed '../Assets/modal.latte', id: 'ad-connection-logout-' . $n, class: 'ad-confirm-dialog', labelledBy: 'ad-connection-logout-title-' . $n}
		{block hidden}
			{input_hidden('desktop_connection', $connection->key())|noescape}
			{input_hidden('desktop_connection_action', 'logout')|noescape}
			{input_token()|noescape}
		{/block}
		{block header}<h2 id="ad-connection-logout-title-{$n}">{$desktop->t('connections.logout')}: {$connection->title()}</h2>{/block}
		{block body}{$desktop->t('connections.logout_confirm')}{/block}
		{block footer}
			<button type="button" data-close autofocus>{$desktop->t('settings.close')}</button>
			<button type="submit" class="ad-primary">{$desktop->t('connections.logout')}</button>
		{/block}
	{/embed}

	{* Forgetting cannot be undone from here: Forget is the red answer, Cancel before it keeps the focus. *}
	{embed '../Assets/modal.latte', id: 'ad-connection-forget-' . $n, class: 'ad-confirm-dialog', labelledBy: 'ad-connection-forget-title-' . $n}
		{block hidden}
			{input_hidden('desktop_connection', $connection->key())|noescape}
			{input_hidden('desktop_connection_action', 'forget')|noescape}
			{input_token()|noescape}
		{/block}
		{block header}<h2 id="ad-connection-forget-title-{$n}">{$desktop->t('connections.forget')}: {$connection->title()}</h2>{/block}
		{block body}{$desktop->t('connections.forget_confirm')}{/block}
		{block footer}
			<button type="button" data-close autofocus>{$desktop->t('settings.close')}</button>
			<button type="submit" class="ad-destructive ad-forget">{$desktop->t('connections.forget')}</button>
		{/block}
	{/embed}
{/foreach}
