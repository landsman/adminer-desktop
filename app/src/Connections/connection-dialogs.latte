{* One edit dialog per saved connection (Connections::dialogs()), in the same order as the cards
	so ad-connection-N is card N. Printed in the sidebar, outside adminer's login form: a form
	cannot nest, and Enter in the name field has to save the name rather than log in.
	Posted to AdminerDesktop::handlePost(), which hands it to Connections::apply(). *}
{parameters
	\AdminerDesktop $desktop,
	array $connections,
	array $colors,
	array $environments
}
{foreach $connections as $connection}
	{embed '../Assets/modal.latte', id: 'ad-connection-' . $iterator->counter, class: 'ad-connection-dialog', lightDismiss: true}
		{block hidden}
			{input_hidden('desktop_connection', $connection->key())|noescape}
			{input_token()|noescape}
		{/block}

		{block header}
			<h2><span class="ad-card-icon">{$connection->icon()|noescape}</span> {$connection->address()}</h2>
		{/block}

		{block body}
			<label class="ad-field">
				<span>{$desktop->t('connections.name')}</span>
				<input name="name" value="{$connection->name}" placeholder="{$connection->address()}" maxlength="60" autocomplete="off">
			</label>

			<label class="ad-field">
				<span>{$desktop->t('connections.environment')}</span>
				<select name="env">
					<option value="">{$desktop->t('connections.none')}</option>
					<option n:foreach="$environments as $environment" value="{$environment->value}" n:attr="selected: $connection->environment === $environment">{$environment->label()}</option>
				</select>
			</label>

			{* No colour falls back to the environment's — Environment::color(). *}
			<fieldset class="ad-swatches">
				<legend>{$desktop->t('connections.color')}</legend>
				<label title="{$desktop->t('connections.color_auto')}"><input type="radio" name="color" value="" n:attr="checked: !$connection->customColor"><span class="ad-swatch ad-swatch-auto"></span></label>
				<label n:foreach="$colors as $color" title="{$color->value}">
					<input type="radio" name="color" value="{$color->value}" n:attr="checked: $connection->customColor === $color">
					<span class="ad-swatch" style="background: {$color->hex()|noescape}"></span>
				</label>
			</fieldset>
		{/block}

		{block footer}
			<button type="submit" formmethod="dialog" formnovalidate>{$desktop->t('settings.close')}</button>
			<button type="submit" class="ad-primary ad-save">{$desktop->t('settings.save')}</button>
		{/block}
	{/embed}
{/foreach}
