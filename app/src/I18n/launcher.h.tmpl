#ifndef AD_I18N_GEN_H
#define AD_I18N_GEN_H
#include <stdlib.h>
#include <string.h>

/* Translation of `en` for the process locale ($LC_MESSAGES/$LANG), or `en` itself: English is
   the base, so a locale with no row for a key falls through to it. */
static const struct { const char *loc, *k, *v; } ad_i18n[] = {
{{rows}}
};

static const char *adTr(const char *en) {
	static const char *loc;
	static int init;
	if (!init) {
		init = 1;
		loc = getenv("LC_MESSAGES");
		if (!loc || !*loc) { loc = getenv("LANG"); }
	}
	if (loc) {
		for (size_t i = 0; i < sizeof(ad_i18n) / sizeof(ad_i18n[0]); i++) {
			if (strncmp(loc, ad_i18n[i].loc, strlen(ad_i18n[i].loc)) == 0 && strcmp(ad_i18n[i].k, en) == 0) {
				return ad_i18n[i].v;
			}
		}
	}
	return en;
}

#endif
