{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "make -s -C \"$CLAUDE_PROJECT_DIR\" dresscode-hook",
						"timeout": 60
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "sh \"$CLAUDE_PROJECT_DIR/cli/kill-orphans.sh\"",
						"timeout": 10
					}
				]
			}
		]
	}
}
